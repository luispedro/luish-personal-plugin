# What plugin.toml can't hold: variables and functions.

# An empty entry first, so that the current directory is looked in first, as in zsh.
CDPATH=:$HOME:$HOME/Sync/work:$HOME/work

# Without /, so that Ctrl-W deletes one component of a path.
WORDCHARS='*?_-.[]~=&;!#%^(){}<>'

# user@host : /path/ (easy to copy with the mouse), show the exit status of the last command if it was non-zero, and use a different prompt character for root
PS1='%[user]@%[hostname] : %[style:keyword]%[dir]%[style_off] %([status]..%[fg:red][%[status]]%[fg_off] )%([root].#.§)'


# cd DIR/FILE goes to DIR, and cd DIR/ls goes to DIR and lists it (cd ls lists the current directory). A real
# directory always wins, and a bare name that isn't one goes to the builtin, so that CDPATH is searched.
cd() {
    if [ $# -eq 1 ] && [ ! -d "$1" ]; then
        case $1 in
        */ls) command cd "${1%/*}/" && command ls --color=auto; return ;;
        ls) command ls --color=auto; return ;;
        */*) [ -f "$1" ] && { command cd "${1%/*}/"; return; } ;;
        esac
    fi
    command cd "$@"
}

# field N [FILE...] prints the Nth field of each line (field NF prints the last).
field() {
    [ -n "$1" ] || { echo 'field N [FILE...]' >&2; return 1; }
    local n="$1"
    shift
    awk "{print \$$n}" "$@"
}

# rename FILE asks for the new name, starting from the current one (to make small changes to a filename).
rename() {
    [ $# -eq 1 ] || { echo 'rename FILE' >&2; return 1; }
    [ -e "$1" ] || [ -L "$1" ] || { echo "rename: $1: no such file" >&2; return 1; }
    local newname="$1"
    vared -p 'rename to: ' newname || return
    [ -n "$newname" ] && [ "$newname" != "$1" ] || return 0
    command mv -i -- "$1" "$newname"
}
